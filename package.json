{
  "name": "hello-motion-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Motion graphics production workspace — code se production-ready video (Remotion + React), story -> script -> storyboard -> timeline -> render -> review.",
  "type": "module",
  "scripts": {
    "preview": "vite --host 0.0.0.0 --port 5173",
    "build:preview": "vite build",
    "studio": "node scripts/patch-studio-proxy.mjs && remotion studio src/remotion/index.ts --host 0.0.0.0 --port 3001",
    "typecheck": "tsc --noEmit",
    "check:links": "node scripts/check-links.mjs",
    "report:assets": "node scripts/report-assets.mjs",
    "report:bundle": "node scripts/report-bundle.mjs",
    "lint": "npm run check:links && npx tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "verify:video": "node scripts/verify-video.mjs",
    "extract:frames": "node scripts/extract-frames.mjs",
    "extract:asi05": "node scripts/extract-asi05-review.mjs",
    "release:check": "npm run lint && npm run build:preview && npm run report:assets",
    "compositions": "remotion compositions src/remotion/index.ts",
    "still": "remotion still src/remotion/index.ts ShowcaseKinetic out/still-showcase.png --frame=180",
    "render:showcase": "remotion render src/remotion/index.ts ShowcaseKinetic out/showcase-kinetic-1080p60.mp4",
    "render:short": "remotion render src/remotion/index.ts ShortHook out/short-hook-9x16.mp4",
    "render:data": "remotion render src/remotion/index.ts DataStory out/data-story-1x1.mp4",
    "render:draft": "remotion render src/remotion/index.ts ShowcaseKinetic out/draft.mp4 --scale=0.5 --crf=28",
    "render:all": "npm run render:showcase && npm run render:short && npm run render:data"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/rozha-one": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/yatra-one": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@remotion/cli": "^4.0.0",
    "@remotion/effects": "^4.0.538",
    "@remotion/google-fonts": "^4.0.538",
    "@remotion/media": "^4.0.538",
    "@remotion/motion-blur": "^4.0.538",
    "@remotion/noise": "^4.0.538",
    "@remotion/paths": "^4.0.538",
    "@remotion/player": "^4.0.0",
    "@remotion/shapes": "^4.0.0",
    "@remotion/three": "^4.0.538",
    "@remotion/transitions": "^4.0.0",
    "@types/flubber": "^0.4.0",
    "@types/three": "^0.187.0",
    "flubber": "^0.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
